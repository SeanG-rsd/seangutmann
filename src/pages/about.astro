---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
	<div class="p-10">
        <div>
            <p>cd ./about/</p>
		</div>
    	<div class="grid bg-black bg-opacity-70">
			<!-- Objective -->
			<h1 class="p-4 text-center">
				Driven computer science student with a curiosity and passion for learning,
				looking for opportunities to gain more technical skills and expand knowledge.
			</h1>
	
			<div>
				<h1 class="section-title">Education</h2>
				<div class="p-4 ml-4 flex flex-col gap-4">
					<div class="flex">
						<p class="info">Sept 2024 to June 2028</p>
						<p class="description">Pursuing a Bachelor of Science in Computer Science Systems</br>
							Oregon State University</br>
							4.0 GPA, Research Fellow, Dean's List</br></br>
							Relevant Coursework: Data Structures, Web Development, Intro to Computer Science II,
							Discrete Math, Calculus 1 & 2, Intro to Matrices and Series
						</p>
					</div>
					<div class="flex">
						<p class="info">Sept 2020 to June 2024</p>
						<p class="description">High School Diploma, Cedarcrest Highschool</br>
							4.0 GPA, Valedictorian</p>
					</div>
				</div>
			</div>

			<!-- Skills -->
			<div>
				<h1 class="section-title">Technical Skills</h2>
				<ul class="list-disc p-4 ml-8">
				<li><span style="font-weight:bold">Languages:</span> C#, Java, C++, Python, Dart, HTML, CSS, JavaScript</li>
				<li><span style="font-weight:bold">Frameworks & Libraries:</span> Unity (2D and 3D), Flutter, React Native, Astro, FastAPI</li>
				<li><span style="font-weight:bold">Developer Tools:</span> Git, Xcode, Firebase, Android Studio, Figma, Notion, Photoshop</li>
				<li><span style="font-weight:bold">Areas of Knowledge:</span> Mobile App Publishing, Machine Learning, Deep Learning</li>
				</ul>
			</div>
		
			<div>
				<h1 class="section-title">Experience</h2>
					<div class="p-4 ml-4 flex flex-col gap-2">
						<div class="flex">
							<p class="info">October 2024 to Present</p>
							<p class="description">Undergraduate Research Assistant</br>
													Oregon State University, Corvallis, OR
						</div>
						<ul class="list-disc p-2 ml-8">
							<li>Collaborating with two other students on a mobile app named Meala, using a large language model (LLM) to provide
							personalized nutrition advice and assist users in reaching nutritional goals.</li>
							<li>Implemented Retrieval-Augmented Generation (RAG) in Python to optimize recipe accuracy using embedded
							documents.</li>
							<li>Redesigned and implemented a user interface in Flutter that displays recipes in a simple, user-friendly format to
							enhance the user experience.</li>
						</ul>
						<div class="flex">
							<p class="info">April 2021 to Present</p>
							<p class="description">Co-Founder</br>
						Nutron Labs LLC, Duvall, WA
							</p>
						</div>
						<ul class="list-disc p-2 ml-8">
							<li>Developer responsible for designing, developing, and publishing five diverse apps on the iOS App Store and Google
							Play Store, all created in Unity with a combined 1000+ downloads</li>
							<li>Apps consist of 2D puzzle games, a 3D multiplayer game, and endless scrollers.</li>
							<li>Designed and developed using various tools including Figma, Notion, Aseprite, Photon Network, Playfab, Unity
							Analytics, and Photoshop.</li>
						</ul>
						<div>
						<div class="flex">
						<p class="info">June 2025 to September 2025</p>
						<p class="description">Seasonal Maintenance Worker</br>
						City of Duvall, Duvall, WA</p>
						</div>
						<ul class="list-disc p-2 ml-8">
							<li>Maintained city parks, wetlands, and roadside areas by weed-whacking, mowing, and clearing brush.</li>
							<li>Drove city vehicles to work sites and operate landscaping equipment while following safety procedures.</li>
						</ul>
						</div>
					</div>
				</div>
		
			<div>
			<h1 class="section-title">Clubs and Leadership</h2>
			<div class="p-4 ml-4 flex gap-4">
				<ul class="list-disc p-4">
					<li>Current Webmaster at OSU App Development Club</li>
					<li>Current Tech Officer at OSU Google Developer Student Club</li>
					<li>BeaverHacks 2025 3rd Place Winner of ACM Track for educational technology.</li>
					<li>Research Fellow: Presented at the Spring Poster Symposium at Oregon State University for URSA Engage.</li>
				</ul>
			</div>
			</div>
    	</div>
    </div>
</Layout>

<style>

	.section-title {
		font-weight: 500;
		display: inline-block;
		border: bottom;
		border-bottom: 2px solid var(--matrix-green);	
		padding: 0 16px 8px 16px;
	}

	.info {
		white-space: nowrap;
		width: 30%;
	}

	.description {
		width: 70%;
	}
	.grid {
        border-color: var(--matrix-green);
        border-width: 2px;
        border-radius: 20px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-items: start;
        box-shadow: 0 0 15px rgba(0, 255, 65, 0.5);
    }

	h1 {
		font-family: 'Fira Code', monospace;
		font-size: 30px;
		margin-top: 0.25em;
	}

	p {
		font-family: 'Fira Code', monospace;
		padding: 10px 10px;
		color: var(--matrix-green);
		font-weight: normal;
	}
</style>
