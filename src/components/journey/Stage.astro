                <g data-a="climber">
                    <path d="M0 -8 L0 -700" fill="none" stroke="#FFE08A" stroke-width="4" />
                    <g data-a="climb-leg-l"><Noodle d="M-13 10 L-54 32 L-44 76" /><use href="#shoe" transform="translate(-44 82) scale(-1 1)" /></g>
                    <g data-a="climb-leg-r"><Noodle d="M13 10 L52 26 L50 72" /><use href="#shoe" x="50" y="78" /></g>
                    <g data-a="climb-arm-l"><Noodle d="M-20 -62 L-50 -104 L-42 -146" /></g>
                    <g data-a="climb-arm-r"><Noodle d="M20 -62 L52 -96 L74 -82" /></g>
                    <path fill={TEE} d="M-26 -76 Q0 -86 26 -76 L23 -8 L-23 -8Z" />
                    <path fill={NAVY} d="M-24 -12 L24 -12 L28 24 L-28 24Z" />
                    <path fill="none" stroke={ORANGE} stroke-width="7" d="M-24 -12 L24 -12" />
                    <circle cx="-8" cy="14" r="10" fill={SUN} />
                    <circle cy="-112" r="31" fill={SKIN} />
                    <path fill={HAIR} d="M-33 -112 C-36 -96 -22 -92 -12 -96 C-4 -90 12 -90 20 -96 C30 -92 36 -100 33 -112Z" />
                    <path fill={ORANGE} d="M-35 -110 C-38 -160 38 -160 35 -110 Q0 -100 -35 -110Z" />
                </g>
            </g>
        </svg>
    </div>

    {/* 2. Forest: mountain biking */}
    <div class="scene" style="--i:2; --top:#1F4D45; --bot:#4F9A63">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="none" stroke={INK} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <rect x="-10" y="-10" width="1620" height="920" fill="#1F4D45" stroke="none" />
            <g stroke="#173B35">
                {backPines.map(([x, y]) => <use href="#pine" transform={`translate(${x} ${y}) scale(1.45)`} color="#27594D" />)}
            </g>
            <path fill="#27594D" stroke="none" d="M-10 360 C400 310 900 400 1620 340 L1620 910 L-10 910Z" />
            <g stroke="#1F4D45">
                {midPines.map(([x, y]) => <use href="#pine" transform={`translate(${x} ${y}) scale(1.7)`} color="#2F6D58" />)}
            </g>
            <path fill="#2F6D58" stroke="none" d="M-10 520 C300 470 800 560 1620 480 L1620 910 L-10 910Z" />
            <path fill="#4F9A63" d="M-60 590 C300 630 500 560 800 620 S1300 720 1660 680 L1660 930 L-60 930Z" />
            <path fill="none" stroke="#B98A5A" stroke-width="30" stroke-linecap="butt" transform="translate(0 22)" d="M-60 590 C300 630 500 560 800 620 S1300 720 1660 680" />
            <path id="trail" fill="none" stroke="none" d="M-60 590 C300 630 500 560 800 620 S1300 720 1660 680" />
            <g><path fill="#7A5138" d="M1000 660 l70 -14 l6 26 l-70 14Z" /><ellipse cx="1072" cy="659" rx="8" ry="14" fill="#C69A6D" transform="rotate(-11 1072 659)" /></g>
            <g data-a="biker">
                <g transform="translate(0 20) scale(1.4)">
                    <g data-a="wheel"><circle cx="-58" cy="-32" r="31" fill="none" stroke-width="7" /><path d="M-58 -60 L-58 -4 M-86 -32 L-30 -32" fill="none" stroke-width="3" /></g>
                    <g data-a="wheel"><circle cx="60" cy="-32" r="31" fill="none" stroke-width="7" /><path d="M60 -60 L60 -4 M32 -32 L88 -32" fill="none" stroke-width="3" /></g>
                    <path fill="none" stroke={ORANGE} stroke-width="8" d="M-58 -32 L-16 -74 L34 -78 L-6 -28 L-58 -32 M-6 -28 L-16 -74 M60 -32 L38 -92 L24 -96" />
                    <path fill="none" stroke-width="7" d="M-30 -80 L-4 -80" />
                    <g data-a="pedal-leg"><Noodle d="M-16 -88 L22 -66 L2 -28" /></g>
                    <path fill={TEE} d="M-26 -82 C-24 -110 2 -136 26 -138 L38 -116 C24 -104 6 -88 -2 -74Z" />
                    <path fill={NAVY} d="M-30 -92 L-2 -72 L8 -58 L-16 -52 L-34 -78Z" />
                    <Noodle d="M26 -128 L40 -106 L30 -94" />
                    <use href="#head" transform="translate(42 -164)" color={HAIR} />
                    <path fill={TEAL} d="M8 -172 C10 -208 76 -208 76 -172 Q42 -184 8 -172Z" />
                </g>
            </g>
            {[[110, 830, 1.3], [1540, 840, 1.25], [840, 830, 1.15], [430, 860, 1]].map(([x, y, s]) => <use href="#pine" transform={`translate(${x} ${y}) scale(${s})`} color="#3D8A5E" />)}
            <g><rect x="1250" y="770" width="14" height="22" fill="#FBF8F0" /><path fill={ORANGE} d="M1234 772 Q1257 738 1280 772Z" /><rect x="660" y="796" width="12" height="18" fill="#FBF8F0" /><path fill="#FF8AA0" d="M646 798 Q666 770 686 798Z" /></g>
        </svg>
    </div>

    {/* 3. Valley road: the truck */}
    <div class="scene" style="--i:3; --top:#4F9A63; --bot:#8DBF66">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="none" stroke={INK} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <path fill="#6FB36B" d="M-10 240 C400 170 1000 290 1620 190 L1620 910 L-10 910Z" />
            <g>
                <path fill="#C7443A" d="M1370 400 L1370 310 L1420 262 L1470 310 L1470 400Z" />
                <path fill="#FBF8F0" d="M1403 400 L1403 352 L1437 352 L1437 400Z" />
                <path fill="#8B3A32" d="M1358 318 L1420 250 L1482 318 L1470 322 L1420 270 L1370 322Z" />
            </g>
            <path fill="#8DBF66" d="M-10 400 C500 330 1100 450 1620 380 L1620 910 L-10 910Z" />
            <g fill="#B98A5A" stroke-width="4">
                {[860, 950, 1040, 1130, 1220, 1310, 1400, 1490, 1580].map((x, index) => <rect x={x} y={392 + index * -1} width="14" height="56" rx="3" />)}
                <path d="M840 416 L1600 408 M840 434 L1600 426" fill="none" stroke="#7A5138" />
            </g>
            {flowers.map(([x, y], index) => <g transform={`translate(${x} ${y - 300})`}><circle r="7" fill={index % 2 ? "#FFF" : SUN} stroke-width="3" /></g>)}
            <rect x="-10" y="590" width="1620" height="104" fill="#4A4658" />
            <path d="M-10 642 L1610 642" fill="none" stroke="#FFE08A" stroke-width="7" stroke-dasharray="46 40" stroke-linecap="butt" />
            {flowers.map(([x, y], index) => <g transform={`translate(${x} ${y})`}><circle r="7" fill={index % 2 ? "#FF8AA0" : "#FFF"} stroke-width="3" /></g>)}
            <g data-a="truck">
                <g transform="translate(0 672) scale(1.55)">
                    <circle class="puff" cx="188" cy="-44" r="9" fill="#FBF8F0" stroke-width="3" />
                    <circle class="puff late" cx="196" cy="-52" r="7" fill="#FBF8F0" stroke-width="3" />
                    <rect x="38" y="-148" width="60" height="60" rx="5" fill="#D9A96B" />
                    <rect x="102" y="-148" width="60" height="60" rx="5" fill="#D9A96B" />
                    <rect x="70" y="-212" width="60" height="60" rx="5" fill="#D9A96B" />
                    <image href="/icons/BattleTanksIcon.png" x="45" y="-141" width="46" height="46" />
                    <image href="/icons/InBetweenWorldsIcon.png" x="109" y="-141" width="46" height="46" />
                    <image href="/icons/SyllabeavsIcon.png" x="77" y="-205" width="46" height="46" />
                    <path fill={ORANGE} d="M-172 -30 L-172 -66 Q-170 -82 -150 -85 L-104 -90 L-72 -142 Q-68 -150 -56 -150 L18 -150 Q28 -150 28 -140 L28 -88 L172 -88 L172 -30Z" />
                    <path fill="#BDE6F1" d="M-88 -92 L-62 -137 L0 -137 L0 -92Z" />
                    <use href="#head" transform="translate(-30 -112) scale(-.68 .68)" color={HAIR} />
                    <path fill="none" d="M4 -86 L4 -32" />
                    <rect x="-172" y="-62" width="20" height="16" rx="5" fill={SUN} stroke-width="4" />
                    <rect x="-180" y="-38" width="50" height="11" rx="5" fill="#E8E4DA" stroke-width="4" />
                    <path fill={INK} stroke="none" d="M-128 -30 A38 38 0 0 1 -50 -30Z M56 -30 A38 38 0 0 1 134 -30Z" />
                    <g data-a="wheel"><circle cx="-89" cy="-30" r="30" fill="#34364F" /><circle cx="-89" cy="-30" r="12" fill="#E8E4DA" /><path d="M-89 -42 L-89 -18" fill="none" stroke-width="3" /></g>
                    <g data-a="wheel"><circle cx="95" cy="-30" r="30" fill="#34364F" /><circle cx="95" cy="-30" r="12" fill="#E8E4DA" /><path d="M95 -42 L95 -18" fill="none" stroke-width="3" /></g>
                </g>
            </g>
        </svg>
    </div>

    {/* 4. Muscle beach: lifting */}
    <div class="scene" style="--i:4; --top:#8DBF66; --bot:#F0D78F">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="none" stroke={INK} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <path fill="#D9C67E" d="M-10 290 C300 220 600 340 1000 270 C1250 230 1430 320 1620 260 L1620 910 L-10 910Z" />
            <g fill="none" stroke="#6E9B50" stroke-width="6">
                <path d="M160 270 q-14 -30 -22 -36 M172 268 q0 -34 2 -46 M184 270 q12 -28 24 -34 M930 280 q-14 -30 -22 -36 M942 278 q0 -34 2 -46 M954 280 q12 -28 24 -34 M1500 288 q-14 -30 -22 -36 M1512 286 q0 -34 2 -46 M1524 288 q12 -28 24 -34" />
            </g>
            <path fill="#F0D78F" d="M-10 470 C400 400 900 520 1620 430 L1620 910 L-10 910Z" />
            <path fill="none" stroke="#D9BE72" stroke-width="5" d="M90 610 q40 -14 80 0 M360 760 q50 -16 100 0 M820 640 q40 -14 80 0 M700 830 q50 -16 100 0 M1540 790 q24 -10 48 0" />
            <path fill="#B98A5A" d="M1020 700 L1480 700 L1500 738 L1000 738Z" />
            <path fill="none" stroke="#7A5138" d="M1110 702 L1104 736 M1200 702 L1198 736 M1300 702 L1302 736 M1390 702 L1396 736" stroke-width="4" />
            <g transform="translate(1250 590) scale(1.6)">
                <g data-a="lifter">
                    <Noodle d="M-13 6 L-32 66" /><use href="#shoe" transform="translate(-32 69) scale(-1 1)" />
                    <Noodle d="M13 6 L32 66" /><use href="#shoe" x="32" y="69" />
                    <path fill={TEE} d="M-27 -76 Q0 -86 27 -76 L23 -8 L-23 -8Z" />
                    <path fill={NAVY} d="M-24 -14 L24 -14 L30 28 L6 30 L0 14 L-6 30 L-30 28Z" />
                    <use href="#head-front" y="-112" color={HAIR} />
                    <Noodle a="lift-arm-l" d="M-22 -68 L-78 -46 L-52 -76" />
                    <Noodle a="lift-arm-r" d="M22 -68 L78 -46 L52 -76" />
                    <g data-a="bar">
                        <rect x="-168" y="-81" width="336" height="10" rx="5" fill="#E8E4DA" stroke-width="4" />
                        <rect x="-132" y="-116" width="20" height="80" rx="7" fill={ORANGE} />
                        <rect x="-112" y="-106" width="14" height="60" rx="6" fill={SUN} />
