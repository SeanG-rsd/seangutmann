---
import Noodle from "./Noodle.astro";

// One scene per page section, stacked top to bottom into a single mountain-to-seafloor
// world. Every scene is drawn on a 1600x900 canvas and the bottom edge of each one is a
// flat color that matches the top of the next, so the seams don't show.
// src/javascript/journey.ts moves the camera and drives anything marked data-a.

const INK = "#1E2140";
const SKIN = "#F6C9A0";
const TEE = "#FBF8F0";
const NAVY = "#24365E";
const ORANGE = "#E8622C";
const SUN = "#FFC83D";
const TEAL = "#00917F";
const HAIR = "#D9A441";

const ridgePines = [[60, 730, 1], [190, 712, 1.2], [320, 735, .9], [470, 750, 1.1], [640, 742, .9], [770, 725, 1.2], [930, 706, 1], [1080, 706, 1.25], [1210, 735, .95], [1360, 745, 1.15], [1490, 730, 1], [1590, 715, 1.2]];
const backPines = [[40, 330], [170, 300], [310, 320], [450, 330], [600, 345], [750, 345], [890, 350], [1030, 345], [1170, 335], [1300, 335], [1430, 325], [1560, 320]];
const midPines = [[-10, 480], [150, 470], [330, 465], [520, 480], [700, 495], [880, 495], [1060, 480], [1240, 470], [1420, 462], [1590, 450]];
const flowers = [[60, 790], [210, 845], [380, 780], [560, 850], [740, 790], [930, 850], [1110, 780], [1290, 850], [1470, 785], [1570, 860]];
const fish: [number, number, number, string][] = [[420, 210, 1, "#FFC83D"], [510, 170, .8, "#FF8A65"], [340, 150, .7, "#FFC83D"], [560, 250, .7, "#FF8A65"], [440, 110, .6, "#FFE08A"]];
const bubbles = [[860, 760, 11], [1010, 690, 7], [1450, 330, 12], [1540, 180, 8], [640, 500, 9], [1120, 140, 7]];
---

<div class="stage" aria-hidden="true" data-stage>
    {/* Shared drawings */}
    <svg class="defs" width="0" height="0">
        <defs>
            <g id="head">
                <circle cx="-22" cy="4" r="8" fill={SKIN} stroke={INK} stroke-width="5" />
                <circle r="31" fill={SKIN} stroke={INK} stroke-width="5" />
                <circle cx="9" cy="1" r="4" fill={INK} />
                <circle cx="23" cy="1" r="4" fill={INK} />
                <path d="M6 14 Q15 24 25 13" fill="none" stroke={INK} stroke-width="4" stroke-linecap="round" />
                <path fill="currentColor" stroke={INK} stroke-width="5" stroke-linejoin="round" d="M-34 -2 C-42 -28 -24 -46 -4 -42 C8 -52 34 -46 36 -24 C40 -18 36 -10 32 -8 C28 -18 20 -24 10 -21 C2 -28 -10 -25 -14 -18 C-20 -20 -22 -8 -24 -4 C-28 0 -32 0 -34 -2Z" />
            </g>
            <g id="head-front">
                <circle r="31" fill={SKIN} stroke={INK} stroke-width="5" />
                <circle cx="-11" cy="1" r="4" fill={INK} />
                <circle cx="11" cy="1" r="4" fill={INK} />
                <path d="M-10 13 Q0 24 10 13Z" fill={INK} stroke={INK} stroke-width="3" stroke-linejoin="round" />
                <path fill="currentColor" stroke={INK} stroke-width="5" stroke-linejoin="round" d="M-33 -4 C-42 -26 -26 -46 -8 -42 C2 -52 28 -48 32 -28 C38 -20 36 -8 32 -4 C28 -14 20 -20 10 -17 C2 -24 -10 -23 -14 -16 C-22 -18 -28 -10 -33 -4Z" />
            </g>
            <g id="pine">
                <rect x="-8" y="12" width="16" height="24" fill="#6B4A3A" />
                <path fill="currentColor" d="M0 -122 L34 -72 L18 -72 L46 -30 L24 -30 L58 14 L-58 14 L-24 -30 L-46 -30 L-18 -72 L-34 -72Z" />
            </g>
            <path id="cloud" fill="#fff" stroke={INK} stroke-width="5" stroke-linejoin="round" d="M-110 30 C-142 30 -150 -10 -112 -16 C-110 -52 -60 -58 -44 -32 C-24 -70 40 -66 48 -24 C84 -46 124 -14 104 14 C122 18 120 30 104 30Z" />
            <g id="fish">
                <path fill="currentColor" d="M34 0 L62 -20 L58 20Z" />
                <ellipse rx="40" ry="22" fill="currentColor" />
                <circle cx="-20" cy="-5" r="4" fill={INK} stroke="none" />
            </g>
            <g id="shoe"><path fill={INK} stroke="none" d="M-11 -7 Q-11 -12 -4 -12 L6 -12 Q24 -8 25 3 L-11 3Z" /></g>
        </defs>
    </svg>

    {/* 0. Summit: hiking */}
    <div class="scene" style="--i:0; --top:#FFB48A; --bot:#FFE3BD">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="none" stroke={INK} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <circle cx="1400" cy="215" r="125" fill="#FFEFB0" stroke="none" opacity=".65" />
            <circle cx="1400" cy="215" r="88" fill="#FFD25E" />
            <g class="drift"><use href="#cloud" transform="translate(840 150) scale(1.1)" /></g>
            <g class="drift slow"><use href="#cloud" transform="translate(600 275) scale(.7)" /></g>
            <path d="M980 110 Q992 98 1004 110 Q1016 98 1028 110" fill="none" />
            <path d="M1050 70 Q1058 62 1066 70 Q1074 62 1082 70" fill="none" />
            <path fill="#C9A7C2" stroke="none" d="M-10 640 L210 400 L340 520 L520 330 L700 560 L900 440 L1010 540 L1300 470 L1620 380 L1620 720 L-10 720Z" />
            <path fill="#7C6E9C" d="M-10 910 L-10 720 L230 600 L420 660 L690 480 L850 580 L1010 470 L1190 340 L1340 505 L1430 470 L1620 640 L1620 910Z" />
            <path fill="#6B5E8B" stroke="none" d="M1190 342 L1340 507 L1430 472 L1618 640 L1618 905 L1090 905 L1230 660 L1150 520Z M692 482 L848 580 L1006 472 L1000 600 L880 760 L760 620Z" />
            <path fill="#fff" d="M1190 340 L1095 409 L1125 440 L1160 412 L1192 452 L1226 416 L1262 446 L1290 450Z" />
            <path fill="#fff" d="M690 480 L620 527 L650 548 L680 525 L712 552 L745 530 L770 530Z" />
            <path fill="#5E5379" d="M-10 910 L-10 800 C300 730 560 840 880 780 C1180 724 1400 810 1620 760 L1620 910Z" />
            <path d="M1235 390 L1235 222" fill="none" stroke-width="7" />
            <path class="flag" fill={ORANGE} d="M1235 224 L1322 244 L1235 276Z" />
            <g transform="translate(1190 258) scale(-1.25 1.25)">
                <g data-a="hiker">
                    <rect x="-46" y="-80" width="34" height="66" rx="13" fill={ORANGE} />
                    <g data-a="hiker-leg-b"><Noodle d="M-8 8 L-14 60" /><use href="#shoe" x="-14" y="66" /></g>
                    <Noodle d="M-18 -64 L-32 -28 L-26 -2" />
                    <path fill={TEE} d="M-25 -76 Q0 -86 25 -76 L23 -8 L-23 -8Z" />
                    <g data-a="hiker-leg-f"><Noodle d="M10 8 L16 60" /><use href="#shoe" x="16" y="66" /></g>
                    <path fill={NAVY} d="M-24 -14 L24 -14 L28 26 L6 28 L0 12 L-6 28 L-28 26Z" />
                    <use href="#head" y="-114" color={HAIR} />
                    <g class="wave"><Noodle d="M18 -66 L44 -98 L40 -136" /></g>
                </g>
            </g>
        </svg>
    </div>

    {/* 1. Rock face: climbing */}
