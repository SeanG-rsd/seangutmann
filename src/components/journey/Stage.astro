<style>
    .stage {
        position: fixed;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        background: #FFB48A;
    }

    .defs { position: absolute; }

    /* Fills the screen on landscape. On portrait it shows only the right half of each
       scene at a larger size, which keeps the character in view, so scenes stack up. */
    .scene {
        position: absolute;
        top: 0;
        right: 0;
        width: max(100vw, 177.78vh);
        aspect-ratio: 16 / 9;
        background: linear-gradient(var(--top), var(--bot));
        will-change: transform;
    }

    /* Without JS only the summit shows. journey.ts takes over the visibility of each scene. */
    .scene:not(:first-of-type) { visibility: hidden; }

    /* The last scene continues as seabed past its bottom edge on tall screens. */
    .scene.last::after {
        content: "";
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        height: 100vh;
        background: #1C3556;
    }

    @media (max-aspect-ratio: 1/1) {
        .scene { width: 205vw; }
    }

    .scene svg {
        display: block;
        width: 100%;
        height: calc(100% + 2px);
    }

    .bubble-text {
        font-family: var(--display);
        font-size: 66px;
    }

    /* Looping idle motion. Everything that follows scroll is in journey.ts. */
    .drift { animation: drift 16s ease-in-out infinite alternate; }
    .drift.slow { animation-duration: 24s; }
    @keyframes drift { to { translate: 70px 0; } }

    .flag {
        transform-box: fill-box;
        transform-origin: 0% 50%;
        animation: flag 1.1s ease-in-out infinite alternate;
    }
    @keyframes flag { from { transform: skewY(-5deg) scaleX(1); } to { transform: skewY(7deg) scaleX(.9); } }

    .wave {
        transform-box: fill-box;
        transform-origin: 0% 100%;
        animation: wave .55s ease-in-out infinite alternate;
    }
    @keyframes wave { from { transform: rotate(-9deg); } to { transform: rotate(14deg); } }

    .sway {
        transform-box: fill-box;
        transform-origin: 50% 100%;
        animation: sway 4.5s ease-in-out infinite alternate;
    }
    .sway.slow { animation-duration: 6.5s; animation-delay: -2s; }
    @keyframes sway { from { transform: rotate(-3.5deg); } to { transform: rotate(4deg); } }

    .bubble {
        animation: rise 5s ease-in infinite;
    }
    .bubble.b1 { animation-delay: -1.7s; animation-duration: 6s; }
    .bubble.b2 { animation-delay: -3.3s; animation-duration: 4.2s; }
    @keyframes rise {
        0% { translate: 0 30px; opacity: 0; }
        15% { opacity: 1; }
        85% { opacity: 1; }
        100% { translate: 18px -120px; opacity: 0; }
    }

    .puff { animation: puff 1.5s ease-out infinite; }
    .puff.late { animation-delay: -.75s; }
    @keyframes puff {
        0% { translate: 0 0; opacity: 0; scale: .6; }
        30% { opacity: 1; }
        100% { translate: 40px -32px; opacity: 0; scale: 1.5; }
    }

    .tent {
        transform-box: fill-box;
        transform-origin: 50% 0%;
        animation: tent 2.6s ease-in-out infinite alternate;
    }
    .tent.t1 { animation-delay: -.5s; }
    .tent.t2 { animation-delay: -1s; }
    .tent.t3 { animation-delay: -1.5s; }
    .tent.t4 { animation-delay: -2s; }
    .tent.bottle-arm {
        transform-origin: 0% 100%;
        animation-duration: 1.6s;
    }
    @keyframes tent { from { transform: rotate(-5deg); } to { transform: rotate(6deg); } }

    @media (prefers-reduced-motion: reduce) {
        .drift, .flag, .wave, .sway, .bubble, .puff, .tent { animation: none; }
    }
</style>
