                    <text class="bubble-text" y="4" x="0" text-anchor="middle" stroke="none" fill={ORANGE}>PR!</text>
                </g>
            </g>
        </svg>
    </div>

    {/* 5. Beach: volleyball and frisbee */}
    <div class="scene" style="--i:5; --top:#F0D78F; --bot:#F0D78F">
        <svg viewBox="0 0 1600 900" preserveAspectRatio="none" stroke={INK} stroke-width="5" stroke-linejoin="round" stroke-linecap="round">
            <defs>
                <linearGradient id="shallows" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#46CAD6" /><stop offset="1" stop-color="#1CA3C2" /></linearGradient>
            </defs>
            <path fill="none" stroke="#D9BE72" d="M120 140 q50 -16 100 0 M600 90 q40 -14 80 0 M1010 130 q40 -14 80 0 M300 420 q50 -16 100 0 M1480 80 q40 -14 80 0" />
            <g transform="translate(868 500)">
                <path fill="#8FD3E0" d="M-96 58 L50 44 L88 70 L-54 88Z" />
                <path d="M0 40 L12 -176" fill="none" stroke-width="7" />
                <path fill={ORANGE} d="M-120 -96 C-96 -196 96 -210 142 -112 C112 -128 92 -124 72 -108 C50 -126 26 -126 8 -108 C-16 -122 -40 -118 -56 -102 C-78 -112 -102 -110 -120 -96Z" />
                <path fill="#FFF9EC" d="M8 -108 C8 -150 8 -176 12 -184 C30 -170 60 -140 72 -108 C50 -126 26 -126 8 -108Z" />
            </g>
