            <path fill="none" stroke="#453B60" d="M90 -5 L160 130 L120 260 L220 400 M620 -5 L560 120 L660 290 L620 420 M290 480 L180 610 L240 720 M880 110 L800 230 L870 340" />
            <path fill="#7C6E9C" d="M980 -12 L1570 -12 L1612 300 L1530 660 L1060 730 L950 340Z" />
            <path fill="#8B7DAA" stroke="none" d="M1000 40 L1250 20 L1180 260 L1020 300Z M1370 320 L1560 280 L1500 600 L1340 560Z" />
            <path fill="none" stroke="#453B60" d="M1090 60 L1150 190 L1090 300 M1450 40 L1400 170 L1470 250 M1110 470 L1190 590 L1140 680" />
            <g>
                <path fill={ORANGE} d="M1168 118 q24 -18 44 0 q6 22 -22 26 q-28 -2 -22 -26Z" />
                <path fill={SUN} d="M1340 88 q26 -12 36 8 q-2 24 -26 18 q-18 -8 -10 -26Z" />
                <path fill={TEAL} d="M1208 250 q22 -18 40 2 q2 22 -22 22 q-24 -2 -18 -24Z" />
                <path fill="#FF8AA0" d="M1352 232 q26 -10 34 10 q-6 24 -28 16 q-16 -8 -6 -26Z" />
                <path fill={SUN} d="M1158 396 q24 -14 38 6 q-4 22 -26 18 q-20 -6 -12 -24Z" />
                <path fill={ORANGE} d="M1372 386 q24 -14 36 6 q-4 22 -26 18 q-18 -6 -10 -24Z" />
                <path fill={TEAL} d="M1214 538 q22 -12 34 6 q-2 22 -24 18 q-18 -6 -10 -24Z" />
                <path fill="#FF8AA0" d="M1340 524 q24 -12 34 8 q-4 20 -24 16 q-18 -6 -10 -24Z" />
            </g>
            {ridgePines.map(([x, y, s]) => <use href="#pine" transform={`translate(${x} ${y}) scale(${s})`} color="#2A6355" />)}
            <path fill="#1F4D45" d="M-10 910 L-10 770 C260 700 520 800 800 745 C1080 690 1330 790 1620 730 L1620 910Z" />
